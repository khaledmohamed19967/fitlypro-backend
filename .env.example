# Environment (local development — use `pnpm run env:production` for production)
NODE_ENV=development

# Server
PORT=8000
APP_PORT=8000

# Public API URL (no trailing slash)
# Local development:
API_URL=http://localhost:8000
# Production (Netlify) — optional override; default is https://fitlypro-backend.netlify.app
# API_URL=https://fitlypro-backend.netlify.app

# API route prefix (default: /api/v1)
# API_PREFIX=/api/v1

# Trust reverse proxy (nginx, Caddy, Railway, Render, etc.) — set true in production
TRUST_PROXY=false

# Database
APP_DB_URL=mongodb://localhost:27017/fitly_pro

# Free Exercise DB import (Phase 3B) — optional override; default:
# data/external/free-exercise-db/exercises.json
# FREE_EXERCISE_DB_PATH=data/external/free-exercise-db/exercises.json

# FatSecret Platform API — server-side only (never expose to frontend)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# FATSECRET_BASE_URL=https://platform.fatsecret.com
# FATSECRET_TOKEN_URL=https://oauth.fatsecret.com/connect/token
# FATSECRET_SCOPE=premier
# FATSECRET_TIMEOUT_MS=15000

# JWT (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s) allowed to call this API
# Development (single app):
# CORS_ORIGIN=http://localhost:3000
# Production (comma-separated, no spaces required):
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# Allow all (not recommended for production):
CORS_ORIGIN=*
