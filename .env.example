# Environment (local development — use `pnpm run env:production` for production)
NODE_ENV=development

# Server
PORT=8000

# Public API URL (no trailing slash)
# Local development:
API_URL=http://localhost:8000
# Production (Netlify) — optional override; default is https://fitlypro-backend.netlify.app
# API_URL=https://fitlypro-backend.netlify.app

# API route prefix (default: /api/v1)
# API_PREFIX=/api/v1

# Trust reverse proxy (nginx, Caddy, Railway, Render, etc.) — set true in production
TRUST_PROXY=false

# Database
APP_DB_URL=mongodb://localhost:27017/fitly_pro

# JWT (for future use)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s) allowed to call this API
# Development (single app):
# CORS_ORIGIN=http://localhost:3000
# Production (comma-separated, no spaces required):
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# Allow all (not recommended for production):
CORS_ORIGIN=*
