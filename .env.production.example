# Production environment (copy to .env.production)
# cp .env.production.example .env.production

NODE_ENV=production
APP_NODE_ENV=production

# Server (Netlify / hosting provider may inject PORT)
PORT=8000
APP_PORT=8000

# Public API — Netlify site URL
API_URL=https://fitlypro-backend.netlify.app
TRUST_PROXY=true

# Database
APP_DB_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=FitlyProCluster

# JWT
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# CORS — set your frontend URL(s), comma-separated
# CORS_ORIGIN=https://your-frontend.netlify.app
CORS_ORIGIN=*
